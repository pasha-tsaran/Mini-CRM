# Скопируйте в .env: все три компонента автоматически читают его из корня проекта.
# Относительный путь разрешается от корня проекта.
DATABASE_PATH=instance/crm.sqlite3
# Часовой пояс только для отображения дат. В БД остаётся UTC.
UI_TIMEZONE=Europe/Moscow

# Не вставляйте реальные токены в этот файл или Git. Окружение имеет приоритет над .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
CRM_BASE_URL=http://127.0.0.1:5000
CRM_BOT_API_TOKEN=
BOT_STATE_PATH=instance/bot-state.sqlite3

# Docker: порт доступен только на 127.0.0.1. Внутренний адрес CRM задаёт Compose.
CRM_PORT=5000
CRM_IMAGE_TAG=local
